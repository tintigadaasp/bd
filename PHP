Step 10 — Create retrieve.php
Create:
C:\xampp\htdocs\Practical5\retrieve.php

Use:
<?php

$m = new MongoClient();

echo "Connection to database successfully";

$db = $m->MYDB239720;

echo "\nDatabase selected successfully";

$col = $db->MyCol;

echo "\nCollection selected successfully";

$cursor = $col->find();

foreach($cursor as $doc)
{
    echo "<br/>";
    echo $doc["name"]."<br/>";
    echo $doc["age"]."<br/>";
    echo $doc["dept"]."<br/>";
    echo $doc["rollno"]."<br/>";
}

?>

