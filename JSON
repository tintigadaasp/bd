Part 2 — Parsing JSON
The journal then creates JSON as a string and converts it into a JavaScript object using JSON.parse().     BDNS Journal
Step 4 — Create parsing.html
<html>

<body>

<script type="text/javascript">

    var data = '{"name":"Romal","age":20,"dept":"IT"}';

    var jsonObj = JSON.parse(data, function(name, value) {

        return value;

    });

    document.writeln(jsonObj.name);

    for (key in jsonObj) {

        document.writeln(
            "<br/>" + key + " : " + jsonObj[key]
        );

    }

</script>

</body>

</html>

This follows the first JSON parsing example in the journal. 
